# URL de l’API appelée par le navigateur (ex. https://api.mondomaine.com).
VITE_API_BASE_URL=
# En local uniquement : laisser VITE_API_BASE_URL vide et rediriger /api vers l’API (évite CORS).
VITE_API_PROXY_TARGET=
VITE_API_TIMEOUT_MS=30000
VITE_MUSIC_ENGINE_ENABLED=true
VITE_MUSIC_API_BASE_URL=
VITE_MUSIC_GENERATE_PATH=/api/v1/music/generate
VITE_MUSIC_JOB_PATH=/api/v1/music/jobs/:id
VITE_MUSIC_TRACKS_PATH=/api/v1/music/tracks
VITE_MUSIC_MY_TRACKS_PATH=/api/v1/music/me/tracks
VITE_MUSIC_RECEIVED_PATH=/api/v1/music/me/received
VITE_MUSIC_GENERATION_LIVE=false
